# ============================================================
# rolling-memory 配置示例
# 复制成 .env 后按需修改（.env 已在 .gitignore 里，不会被提交）
# ============================================================

# ------------------------------------------------------------
# 【1】结算上游 —— 必配
# 用于把滑出窗口的消息压缩成摘要。任何 OpenAI 兼容接口都行。
# 推荐用便宜的模型：这里是纯压缩任务，不需要强推理。
# ------------------------------------------------------------
LEDGER_API_URL=https://api.deepseek.com/v1/chat/completions
LEDGER_API_KEY=sk-xxxx
LEDGER_MODEL=deepseek-chat

# ------------------------------------------------------------
# 【2】对话上游 —— 只有用内置代理（npm run proxy）时才需要
#
# 设计意图：对话和结算走不同厂商完全合法，而且是最常见的用法——
#   例如：对话用 Grok / GPT / Claude（要质量），结算用 DeepSeek（要便宜）。
#
# 优先级规则：
#   · CHAT_API_URL 不填时，回退到 LEDGER_API_URL（对话与结算同源）
#   · 密钥优先级：客户端请求自带的 Authorization > CHAT_API_KEY > LEDGER_API_KEY
#     也就是说——大多数客户端只需把接口地址改成代理地址，密钥原样不用动。
#
# 【重要提醒】多数字段的并发/限流按【账号】计，同一个厂商多开几个 Key
#   并不会提升并发额度。双上游的价值是解耦「模型选择」与「计费口径」，
#   不是突破限流。不要指望靠它绕过配额。
# ------------------------------------------------------------
CHAT_API_URL=https://api.x.ai/v1/chat/completions
CHAT_API_KEY=xai-xxxx

# ------------------------------------------------------------
# 【3】摘要规模
# ------------------------------------------------------------
# 触发结算的条数（主判据）：滑出窗口的消息攒够这么多条就结算一次
LEDGER_BUFFER_COUNT=6
# 触发结算的字数（兜底）：单批特别长时，即使条数没到也提前结算
LEDGER_BUFFER_CHARS=400
# 缓冲上限：连续结算失败时丢最旧，防止内存无限膨胀
LEDGER_PENDING_MAX_CHARS=12000
# T1 近期摘要封顶（"话题行 + 状态节"的总和）。超过则从**最旧端摘行**并入 T2，
#   不再是"整段压进 T2"。所以模型可以放心把每条话题写足——
#   长度由代码机械控制，不会出现"为了塞话题数把每条压成几个字"的问题。
LEDGER_T1_MAX_CHARS=1500
# T2 远期梗概封顶（事实骨架，只留时间戳 + 主线）
#   v1.3 起上限 360：220 装不下"能独立读懂"的短句，只会逼出电报体。
LEDGER_T2_MAX_CHARS=360
# T2 日期淘汰：比这更旧的行直接丢，不再永久保留（v1.3 新增）
LEDGER_T2_MAX_DAYS=7
# T1 淘汰保底行数：一次结算至少留这么多行，防把 T1 摘空（v1.3 新增）
LEDGER_MIN_KEEP_T1=3

# ------------------------------------------------------------
# 【4】角色称呼（写进结算 prompt 的显示名，纯展示用）
# ------------------------------------------------------------
LEDGER_USER_LABEL=user
LEDGER_ASSISTANT_LABEL=assistant

# ------------------------------------------------------------
# 【5】其他
# ------------------------------------------------------------
LEDGER_LLM_TIMEOUT_MS=60000
LEDGER_ENABLED=true

# 摘要落盘目录（可选，默认模块内 state/）
# 注意：这个目录会被两个进程同时读写（结算进程 + 查看器编辑），模块内部用
#       tmp+rename 原子替换，并用一个 .reload 标记文件做"改完请重读"的跨进程通知。
# ROLLING_MEMORY_STATE_DIR=/var/lib/rolling-memory

# 本地转发代理端口（npm run proxy，给没有网关的用户）
PROXY_PORT=8787

# 迷你查看器端口（npm run view）
VIEWER_PORT=8788
