# 结算用的 OpenAI 兼容接口（必配）
LEDGER_API_URL=https://api.example.com/v1/chat/completions
LEDGER_API_KEY=sk-xxxx
LEDGER_MODEL=gpt-4o-mini

# 摘要规模
LEDGER_BUFFER_CHARS=400
LEDGER_PENDING_MAX_CHARS=12000
LEDGER_T1_MAX_CHARS=1200
LEDGER_T2_MAX_CHARS=220

# 角色称呼（进结算 prompt 的显示名）
LEDGER_USER_LABEL=user
LEDGER_ASSISTANT_LABEL=assistant

# 其他
LEDGER_LLM_TIMEOUT_MS=60000
LEDGER_ENABLED=true

# 摘要落盘目录（可选，默认模块内 state/）
# ROLLING_MEMORY_STATE_DIR=/var/lib/rolling-memory

# 本地转发代理端口（npm run proxy，给没有网关的用户）
PROXY_PORT=8787

# 迷你查看器端口（npm run view）
VIEWER_PORT=8788
